{
  "name": "ModerationFlag",
  "type": "object",
  "properties": {
    "reporter_id": {
      "type": "string"
    },
    "target_type": {
      "type": "string",
      "enum": [
        "observation",
        "comment",
        "user"
      ]
    },
    "target_id": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "dismissed",
        "actioned"
      ],
      "default": "pending"
    }
  },
  "required": [
    "target_type",
    "target_id",
    "reason"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}